## 6. Lavalink Manager

### Access in Commands

```typescript
async execute({ message, args, lavalinkManager }) {
  // Get player
  const player = lavalinkManager.getPlayer(message.guild!.id);

  // Create player
  const player = lavalinkManager.createPlayer({
    guildId: message.guild!.id,
    voiceChannelId: voiceChannel.id,
    textChannelId: message.channel.id,
    selfDeaf: true,
    selfMute: false,
  });

  // Connect
  if (!player.connected) {
    await player.connect();
  }

  // Play
  await player.play();

  // Queue operations
  await player.queue.add(track);
  player.queue.tracks.length;
  player.queue.current;

  // Control
  player.skip();
  player.pause();
  player.resume();
  player.seek(position);
  player.setVolume(volume);
  player.destroy();
}
```

### Common Patterns

```typescript
// Check if playing
if (!player || !player.queue.current) {
  await message.reply(translate(locale, 'commands.mycommand.not_playing'));
  return;
}

// Get current track
const track = player.queue.current;
const position = player.position; // milliseconds
const duration = track.info.duration; // milliseconds

// Search tracks
const res = await player.search(
  {
    query: query,
    source: 'ytsearch', // or undefined for URL
  },
  message.author // requester
);

// Handle search result
if (res.loadType === 'playlist') {
  // Handle playlist
} else {
  // Handle single track
  const track = res.tracks[0];
}
```

