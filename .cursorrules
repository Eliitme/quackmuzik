## 3. Database Utilities

### Available Functions

From `src/utils/database.ts`:

```typescript
// Prefix management
getGuildPrefix(guildId: string | null, defaultPrefix?: string): Promise<string>
setGuildPrefix(guildId: string, prefix: string): Promise<boolean>
resetGuildPrefix(guildId: string): Promise<boolean>

// Locale management
getGuildLocale(guildId: string | null, defaultLocale?: string): Promise<string>
setGuildLocale(guildId: string, locale: string): Promise<boolean>
```

### Usage Pattern

```typescript
import { getGuildLocale, getGuildPrefix, setGuildLocale } from '../../utils/database';

// Get locale (always use in commands)
const locale = (await getGuildLocale(message.guild?.id || null)) as Locale;

// Get prefix (if need to display in message)
const prefix = await getGuildPrefix(message.guild?.id || null, 'z!');

// Set locale (with validation)
try {
  await setGuildLocale(guildId, 'en');
} catch (error) {
  logger.error('Error setting locale', { error });
}
```

