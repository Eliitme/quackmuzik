## 4. Embed Creation

### Available Functions

From `src/utils/embed.ts`:

```typescript
// Basic embed with default footer
createEmbed(options?: {
  title?: string;
  description?: string;
  color?: ColorResolvable;
  footer?: string;
  timestamp?: boolean;
}): EmbedBuilder

// Embed with custom footer (append to default)
createEmbedWithCustomFooter(
  customFooter: string,
  options?: {
    title?: string;
    description?: string;
    color?: ColorResolvable;
    timestamp?: boolean;
  }
): EmbedBuilder
```

### Usage Pattern

```typescript
import { createEmbed, createEmbedWithCustomFooter } from '../../utils/embed';

// Basic embed
const embed = createEmbed({
  title: translate(locale, 'commands.mycommand.title'),
  description: translate(locale, 'commands.mycommand.description'),
  color: '#00FF00', // Optional
});

// Embed with custom footer
const embed = createEmbedWithCustomFooter(
  translate(locale, 'commands.mycommand.footer'),
  {
    title: translate(locale, 'commands.mycommand.title'),
    description: '...',
  }
);

// Add fields
embed.addFields(
  {
    name: translate(locale, 'commands.mycommand.field1'),
    value: 'value',
    inline: true,
  },
  {
    name: '\u200B', // Zero-width space for spacing
    value: '...',
    inline: false,
  }
);

// Set thumbnail
embed.setThumbnail(url);

// Send
await message.reply({ embeds: [embed] });
```

