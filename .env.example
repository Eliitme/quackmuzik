# ===================================
# QuackMuzik Discord Bot Configuration
# ===================================

# === Discord Bot Credentials ===
# Get these from: https://discord.com/developers/applications
# 1. Create a new application
# 2. Go to "Bot" section and create a bot
# 3. Copy the token
# 4. Copy the Application ID (Client ID) from "General Information"
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here

# === Lavalink Connection ===
# Default values for Docker setup
# Change these only if you modify docker-compose.yml
LAVALINK_HOST=lavalink
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass

# ===================================
# MUSIC PLATFORM CREDENTIALS
# ===================================
# Note: You can enable/disable platforms in lavalink/application.yml
# Leave empty if you don't want to use a specific platform

# === SPOTIFY ===
# Required for Spotify support
# Get credentials from: https://developer.spotify.com/dashboard
#
# Steps:
# 1. Go to https://developer.spotify.com/dashboard
# 2. Log in with your Spotify account
# 3. Click "Create app"
# 4. Fill in:
#    - App name: QuackMuzik (or any name)
#    - App description: Discord music bot
#    - Redirect URI: http://localhost (not used but required)
#    - Check "Web API" in APIs used
# 5. Click "Settings" and copy:
#    - Client ID
#    - Client Secret (click "View client secret")
#
# Free tier includes: 25,000 API calls per day
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# === APPLE MUSIC ===
# Required for Apple Music support
# Get credentials from: https://developer.apple.com/
#
# Steps (Advanced - requires Apple Developer Program):
# 1. Join Apple Developer Program ($99/year or free for students)
#    https://developer.apple.com/programs/
# 2. Go to https://developer.apple.com/account/resources/authkeys/list
# 3. Create a new key with "MusicKit" enabled
# 4. Download the .p8 private key file
# 5. Note your:
#    - Key ID (from the key details)
#    - Team ID (top right of the page)
# 6. Generate a JWT token using:
#    - Private key (.p8 file)
#    - Key ID
#    - Team ID
#
# JWT Generation: Use online tools or libraries to create a JWT
# Example using Python: https://github.com/topi314/LavaSrc#apple-music
#
# Note: Apple Music requires a paid developer account
APPLE_MUSIC_API_TOKEN=

# === DEEZER ===
# Optional - Deezer works without credentials for basic usage
# Master decryption key for full track access (optional)
#
# Get key from:
# 1. Visit https://developers.deezer.com/api
# 2. Create an application (free)
# 3. Use the Deezer API to get your master key
#
# Note: Basic playback works WITHOUT this key
DEEZER_MASTER_KEY=

# === YANDEX MUSIC ===
# Required for Yandex Music support (popular in Russia/CIS)
# Get token from: https://github.com/MarshalX/yandex-music-api
#
# Steps:
# 1. Create a Yandex account at https://yandex.com
# 2. Subscribe to Yandex Music (may require payment depending on region)
# 3. Use yandex-music-api library to generate token:
#    pip install yandex-music
# 4. Follow authentication guide:
#    https://yandex-music.readthedocs.io/en/main/
#
# Note: Requires Yandex account with Music subscription
YANDEX_MUSIC_TOKEN=

# ===================================
# SUPPORTED PLATFORMS
# ===================================
#
# With credentials:
# ✅ YouTube (no API key needed - using yt-cipher)
# ✅ YouTube Music (same as YouTube)
# ✅ Spotify (with SPOTIFY_CLIENT_ID and SPOTIFY_CLIENT_SECRET)
# ✅ Apple Music (with APPLE_MUSIC_API_TOKEN)
# ✅ Deezer (works without key, better with DEEZER_MASTER_KEY)
# ✅ Yandex Music (with YANDEX_MUSIC_TOKEN)
# ✅ SoundCloud (no API key needed)
# ✅ Bandcamp (no API key needed)
# ✅ Twitch (no API key needed)
# ✅ Vimeo (no API key needed)
# ✅ HTTP streams (direct audio URLs)
#
# Without any additional setup:
# ✅ YouTube / YouTube Music
# ✅ SoundCloud
# ✅ Bandcamp
# ✅ Twitch
# ✅ Vimeo
# ✅ Deezer (limited)
# ✅ HTTP streams
#
# Requires credentials for full features:
# 🔑 Spotify (track search, playlists, albums)
# 🔑 Apple Music (track search, playlists, albums)
# 🔑 Yandex Music (all features)

# ===================================
# USAGE EXAMPLES
# ===================================
#
# Once configured, use these commands in Discord:
#
# YouTube:
# q!play https://www.youtube.com/watch?v=dQw4w9WgXcQ
# q!play Never Gonna Give You Up
#
# Spotify (requires SPOTIFY_* credentials):
# q!play https://open.spotify.com/track/4cOdK2wGLETKBW3PvgPWqT
# q!play spotify:track:4cOdK2wGLETKBW3PvgPWqT
# q!play https://open.spotify.com/playlist/37i9dQZF1DXcBWIGoYBM5M
#
# SoundCloud:
# q!play https://soundcloud.com/artist/song
#
# Apple Music (requires APPLE_MUSIC_API_TOKEN):
# q!play https://music.apple.com/us/album/song/123456789
#
# Deezer:
# q!play https://www.deezer.com/track/123456789
#
# Direct links:
# q!play https://example.com/audio.mp3
