{
  "name": "quackmuzik",
  "version": "1.0.0",
  "description": "Discord music bot with Lavalink",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && npm run copy:locales",
    "copy:locales": "mkdir -p dist/locales && cp -r src/locales/* dist/locales/",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "watch": "tsc -w",
    "format": "prettier --write \"src/**/*.{ts,js,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json}\""
  },
  "keywords": [
    "discord",
    "music",
    "bot",
    "lavalink"
  ],
  "author": "",
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "discord.js": "^14.14.1",
    "lavalink-client": "^2.4.0",
    "dotenv": "^16.3.1",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "@types/pg": "^8.10.9",
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "prettier": "^3.1.1"
  }
}
